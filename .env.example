# ---------------------------------------------------------------
# ResQLink — Environment configuration (EXAMPLE)
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# Never commit the real `.env` file. Never hard-code secrets.
# ---------------------------------------------------------------

# Application
APP_NAME=ResQLink
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Session
SESSION_NAME=resqlink_session
SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_SAMESITE=Lax

# Database (MySQL 8+)
# Use a least-privilege application user (not root), per DATABASE.md §37.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=resqlink
DB_USER=resqlink_app
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4

# AI provider (optional — application must work without it)
# Leave blank to disable AI: the app then uses deterministic keyword fallbacks.
# All AI access goes through App\Services\AIService — never a vendor SDK.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=
# AI_TIMEOUT_SECONDS=10

# Maps (Leaflet + OpenStreetMap need no key; placeholders for future geocoding)
MAP_PROVIDER=openstreetmap
GEOCODING_API_KEY=
# Notification / map poll interval in seconds (10–15 recommended)
MAP_POLL_INTERVAL_SECONDS=12
# LEAFLET_CSS_URL=
# LEAFLET_JS_URL=

# Analytics (Phase 11) — Chart.js is optional; the dashboard always renders
# accessible data tables, so charts are purely progressive enhancement.
# CHARTJS_JS_URL=https://unpkg.com/chart.js@4.4.1/dist/chart.umd.js
# ANALYTICS_DEFAULT_PERIOD=week

# Mail (optional)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@resqlink.local

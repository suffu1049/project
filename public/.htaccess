# ResQLink — Apache configuration for the public document root.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Route everything that is not an existing file/directory to the front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Do not list directory contents.
Options -Indexes

# Block access to dotfiles (e.g. .env, .htaccess) if the document root ever
# contains them.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Prevent execution of uploaded content.
<FilesMatch "\.(php|phtml|phar)$">
    Require all denied
</FilesMatch>
